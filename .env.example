# Copia este archivo como .env (desarrollo local) o crea las mismas variables
# como "Repository variables" en GitHub (Settings → Secrets and variables → Actions → Variables).
# Sin estas variables la app corre en "modo demo local" (solo entre pestañas del mismo navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
# Correo de la cuenta del profesor creada en Firebase Authentication (Email/Password)
VITE_HOST_EMAIL=profesor@tu-dominio.com
